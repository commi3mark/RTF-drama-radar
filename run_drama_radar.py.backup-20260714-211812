from __future__ import annotations

import json
import os
import socket
import subprocess
import sys
import time
import traceback
from dataclasses import asdict, dataclass
from datetime import datetime, timedelta, timezone
from pathlib import Path
from typing import Any


# ============================================================
# CONFIGURATION
# ============================================================

ROOT = Path(__file__).resolve().parent

LOGS_DIR = ROOT / "logs"
LATEST_LOG = LOGS_DIR / "latest-run.log"
PREVIOUS_LOG = LOGS_DIR / "previous-run.log"
HEALTH_FILE = LOGS_DIR / "health.json"

LOCK_FILE = ROOT / ".drama-radar.lock"

PYTHON_EXECUTABLE = sys.executable

# A lock older than this is assumed to have been left behind by
# a crashed or interrupted run.
STALE_LOCK_AFTER_HOURS = 4

# Maximum time allowed for each Python stage.
SCRIPT_TIMEOUT_MINUTES = 90

# Maximum number of retained dated logs.
MAX_ARCHIVED_LOGS = 14

# Git push retry behaviour.
GIT_PUSH_ATTEMPTS = 3
GIT_PUSH_RETRY_SECONDS = 30

# These JSON files must be valid before anything is committed.
REQUIRED_JSON_FILES = [
    ROOT / "drama-radar.json",
    ROOT / "transcript-manifest.json",
    ROOT / "mention-index.json",
]

# This file is optional because it may not exist until a transcript
# has failed at least once.
OPTIONAL_JSON_FILES = [
    ROOT / "transcript-retries.json",
]

# ------------------------------------------------------------
# PIPELINE SCRIPTS
# ------------------------------------------------------------
#
# The runner will search for the first existing collector script
# from this list.
#
# Put the real filename used to create drama-radar.json at the top.
#

COLLECTOR_CANDIDATES = [
    "build_radar.py",
]

# This one is known from the current project.
TRANSCRIPT_SCRIPT = "enrich_transcripts.py"

# Set this to False while testing if you do not want automatic
# Git commits and pushes.
ENABLE_GIT_PUSH = False

# Files and folders Git should consider.
GIT_PATHS = [
    "drama-radar.json",
    "transcript-manifest.json",
    "transcript-retries.json",
    "mention-index.json",
    "transcripts",
    "logs/health.json",
]


# ============================================================
# DATA CLASSES
# ============================================================

@dataclass
class StageResult:
    name: str
    command: list[str]
    started_at: str
    completed_at: str
    duration_seconds: float
    success: bool
    return_code: int | None
    timed_out: bool
    skipped: bool
    message: str


# ============================================================
# GENERAL HELPERS
# ============================================================

def utc_now() -> datetime:
    return datetime.now(timezone.utc)


def iso_now() -> str:
    return utc_now().isoformat()


def write_console(message: str = "") -> None:
    print(message, flush=True)


def write_log(message: str = "") -> None:
    timestamp = datetime.now().strftime("%Y-%m-%d %H:%M:%S")
    line = f"[{timestamp}] {message}"

    write_console(line)

    LOGS_DIR.mkdir(parents=True, exist_ok=True)

    with LATEST_LOG.open("a", encoding="utf-8") as file:
        file.write(line + "\n")


def load_json(path: Path, default: Any = None) -> Any:
    if not path.exists():
        return default

    with path.open("r", encoding="utf-8") as file:
        return json.load(file)


def save_json(path: Path, data: Any) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)

    temporary = path.with_suffix(path.suffix + ".tmp")

    with temporary.open("w", encoding="utf-8") as file:
        json.dump(data, file, ensure_ascii=False, indent=2)
        file.write("\n")

    temporary.replace(path)


def prepare_logs() -> None:
    LOGS_DIR.mkdir(parents=True, exist_ok=True)

    if LATEST_LOG.exists():
        if PREVIOUS_LOG.exists():
            PREVIOUS_LOG.unlink()

        LATEST_LOG.replace(PREVIOUS_LOG)

    LATEST_LOG.touch()

    delete_old_logs()


def archive_current_log() -> None:
    if not LATEST_LOG.exists():
        return

    timestamp = datetime.now().strftime("%Y-%m-%d_%H-%M-%S")
    archived_log = LOGS_DIR / f"run-{timestamp}.log"

    try:
        archived_log.write_text(
            LATEST_LOG.read_text(encoding="utf-8"),
            encoding="utf-8",
        )
    except OSError:
        pass

    delete_old_logs()


def delete_old_logs() -> None:
    dated_logs = sorted(
        LOGS_DIR.glob("run-*.log"),
        key=lambda path: path.stat().st_mtime,
        reverse=True,
    )

    for old_log in dated_logs[MAX_ARCHIVED_LOGS:]:
        try:
            old_log.unlink()
        except OSError:
            pass


# ============================================================
# LOCK HANDLING
# ============================================================

def lock_age_hours() -> float | None:
    if not LOCK_FILE.exists():
        return None

    try:
        modified = datetime.fromtimestamp(
            LOCK_FILE.stat().st_mtime,
            tz=timezone.utc,
        )
    except OSError:
        return None

    return max(
        0.0,
        (utc_now() - modified).total_seconds() / 3600,
    )


def acquire_lock() -> bool:
    if LOCK_FILE.exists():
        age = lock_age_hours()

        if age is not None and age < STALE_LOCK_AFTER_HOURS:
            existing = load_json(LOCK_FILE, {})
            write_log(
                "Another Drama Radar run appears to be active. "
                f"Lock information: {existing}"
            )
            return False

        write_log(
            "Removing stale lock file"
            + (
                f" aged {age:.2f} hours."
                if age is not None
                else "."
            )
        )

        try:
            LOCK_FILE.unlink()
        except OSError as error:
            write_log(f"Could not remove stale lock: {error}")
            return False

    lock_information = {
        "started_at": iso_now(),
        "pid": os.getpid(),
        "computer": socket.gethostname(),
        "python": PYTHON_EXECUTABLE,
    }

    save_json(LOCK_FILE, lock_information)
    write_log(f"Lock acquired by process {os.getpid()}.")
    return True


def release_lock() -> None:
    try:
        if LOCK_FILE.exists():
            LOCK_FILE.unlink()

        write_log("Lock released.")
    except OSError as error:
        write_log(f"WARNING - could not remove lock file: {error}")


# ============================================================
# SCRIPT DISCOVERY
# ============================================================

def find_collector_script() -> Path | None:
    for filename in COLLECTOR_CANDIDATES:
        candidate = ROOT / filename

        if candidate.exists():
            return candidate

    return None


# ============================================================
# PROCESS EXECUTION
# ============================================================

def run_command(
    name: str,
    command: list[str],
    timeout_minutes: int = SCRIPT_TIMEOUT_MINUTES,
    skip_reason: str | None = None,
) -> StageResult:
    started = utc_now()

    if skip_reason:
        write_log(f"SKIPPED — {name}: {skip_reason}")

        return StageResult(
            name=name,
            command=command,
            started_at=started.isoformat(),
            completed_at=utc_now().isoformat(),
            duration_seconds=0,
            success=True,
            return_code=None,
            timed_out=False,
            skipped=True,
            message=skip_reason,
        )

    write_log("")
    write_log("=" * 65)
    write_log(f"STARTING — {name}")
    write_log(f"COMMAND  — {' '.join(command)}")
    write_log("=" * 65)

    timed_out = False
    return_code: int | None = None
    message = ""

    try:
        process = subprocess.Popen(
            command,
            cwd=ROOT,
            stdout=subprocess.PIPE,
            stderr=subprocess.STDOUT,
            text=True,
            encoding="utf-8",
            errors="replace",
            bufsize=1,
        )

        assert process.stdout is not None

        deadline = time.monotonic() + timeout_minutes * 60

        while True:
            line = process.stdout.readline()

            if line:
                write_log(f"[{name}] {line.rstrip()}")

            if process.poll() is not None:
                for remaining_line in process.stdout:
                    write_log(f"[{name}] {remaining_line.rstrip()}")
                break

            if time.monotonic() >= deadline:
                timed_out = True
                process.kill()
                message = (
                    f"Stage exceeded its {timeout_minutes}-minute timeout."
                )
                write_log(f"TIMEOUT — {name}: {message}")
                break

            if not line:
                time.sleep(0.2)

        return_code = process.wait()

        if timed_out:
            success = False
        else:
            success = return_code == 0

        if not message:
            message = (
                "Completed successfully."
                if success
                else f"Exited with code {return_code}."
            )

    except FileNotFoundError as error:
        success = False
        message = str(error)
        write_log(f"FAILED — {name}: {message}")

    except Exception as error:
        success = False
        message = f"{type(error).__name__}: {error}"
        write_log(f"FAILED — {name}: {message}")
        write_log(traceback.format_exc())

    completed = utc_now()
    duration = (completed - started).total_seconds()

    write_log(
        f"FINISHED — {name}: "
        f"{'SUCCESS' if success else 'FAILED'} "
        f"after {duration:.1f} seconds."
    )

    return StageResult(
        name=name,
        command=command,
        started_at=started.isoformat(),
        completed_at=completed.isoformat(),
        duration_seconds=round(duration, 2),
        success=success,
        return_code=return_code,
        timed_out=timed_out,
        skipped=False,
        message=message,
    )


# ============================================================
# JSON VALIDATION
# ============================================================

def validate_json_file(path: Path, required: bool) -> dict[str, Any]:
    result = {
        "file": path.name,
        "path": str(path),
        "required": required,
        "exists": path.exists(),
        "valid": False,
        "size_bytes": None,
        "item_count": None,
        "error": None,
    }

    if not path.exists():
        if required:
            result["error"] = "Required file does not exist."
        else:
            result["valid"] = True
            result["error"] = "Optional file does not exist yet."

        return result

    try:
        result["size_bytes"] = path.stat().st_size

        with path.open("r", encoding="utf-8") as file:
            data = json.load(file)

        result["valid"] = True

        if isinstance(data, (list, dict)):
            result["item_count"] = len(data)

        if path.name == "drama-radar.json" and not isinstance(data, list):
            result["valid"] = False
            result["error"] = "drama-radar.json must contain a JSON list."

        if (
            path.name == "transcript-manifest.json"
            and not isinstance(data, list)
        ):
            result["valid"] = False
            result["error"] = (
                "transcript-manifest.json must contain a JSON list."
            )

        if (
            path.name == "mention-index.json"
            and not isinstance(data, dict)
        ):
            result["valid"] = False
            result["error"] = (
                "mention-index.json must contain a JSON object."
            )

    except json.JSONDecodeError as error:
        result["error"] = (
            f"Invalid JSON at line {error.lineno}, "
            f"column {error.colno}: {error.msg}"
        )

    except OSError as error:
        result["error"] = str(error)

    return result


def validate_all_json() -> tuple[bool, list[dict[str, Any]]]:
    write_log("")
    write_log("Validating generated JSON files...")

    results: list[dict[str, Any]] = []

    for path in REQUIRED_JSON_FILES:
        results.append(validate_json_file(path, required=True))

    for path in OPTIONAL_JSON_FILES:
        results.append(validate_json_file(path, required=False))

    all_required_valid = all(
        result["valid"]
        for result in results
        if result["required"]
    )

    for result in results:
        status = "VALID" if result["valid"] else "INVALID"

        write_log(
            f"{status} — {result['file']} "
            f"({result.get('size_bytes')} bytes, "
            f"{result.get('item_count')} items)"
        )

        if result.get("error"):
            write_log(f"         {result['error']}")

    return all_required_valid, results


# ============================================================
# GIT HANDLING
# ============================================================

def git_available() -> bool:
    result = run_command(
        name="Git availability check",
        command=["git", "--version"],
        timeout_minutes=2,
    )

    return result.success


def git_repository_exists() -> bool:
    return (ROOT / ".git").exists()


def existing_git_paths() -> list[str]:
    paths: list[str] = []

    for relative_path in GIT_PATHS:
        if (ROOT / relative_path).exists():
            paths.append(relative_path)

    return paths


def git_has_staged_changes() -> bool:
    result = subprocess.run(
        ["git", "diff", "--cached", "--quiet"],
        cwd=ROOT,
        check=False,
    )

    # git diff --quiet returns 1 when differences exist.
    return result.returncode == 1


def perform_git_update() -> list[StageResult]:
    results: list[StageResult] = []

    if not ENABLE_GIT_PUSH:
        results.append(
            run_command(
                name="Git update",
                command=["git"],
                skip_reason="ENABLE_GIT_PUSH is False.",
            )
        )
        return results

    if not git_repository_exists():
        results.append(
            run_command(
                name="Git update",
                command=["git"],
                skip_reason=f"{ROOT} is not a Git repository.",
            )
        )
        return results

    if not git_available():
        return results

    paths = existing_git_paths()

    if not paths:
        results.append(
            run_command(
                name="Git add",
                command=["git", "add"],
                skip_reason="None of the configured Git paths exist.",
            )
        )
        return results

    add_result = run_command(
        name="Git add",
        command=["git", "add", "--", *paths],
        timeout_minutes=10,
    )
    results.append(add_result)

    if not add_result.success:
        return results

    try:
        staged_changes = git_has_staged_changes()
    except Exception as error:
        results.append(
            run_command(
                name="Git changes check",
                command=["git", "diff", "--cached", "--quiet"],
                skip_reason=f"Could not check staged changes: {error}",
            )
        )
        return results

    if not staged_changes:
        results.append(
            run_command(
                name="Git commit",
                command=["git", "commit"],
                skip_reason="No new changes to commit.",
            )
        )
        return results

    commit_message = (
        "Automated Drama Radar update "
        + datetime.now().strftime("%Y-%m-%d %H:%M")
    )

    commit_result = run_command(
        name="Git commit",
        command=["git", "commit", "-m", commit_message],
        timeout_minutes=10,
    )
    results.append(commit_result)

    if not commit_result.success:
        return results

    push_succeeded = False

    for attempt in range(1, GIT_PUSH_ATTEMPTS + 1):
        push_result = run_command(
            name=f"Git push attempt {attempt}",
            command=["git", "push"],
            timeout_minutes=15,
        )
        results.append(push_result)

        if push_result.success:
            push_succeeded = True
            break

        if attempt < GIT_PUSH_ATTEMPTS:
            write_log(
                f"Git push failed. Waiting "
                f"{GIT_PUSH_RETRY_SECONDS} seconds before retry."
            )
            time.sleep(GIT_PUSH_RETRY_SECONDS)

    if not push_succeeded:
        write_log(
            "Git push did not succeed. The commit remains locally and "
            "can be pushed by the next run."
        )

    return results


# ============================================================
# HEALTH REPORT
# ============================================================

def build_health_report(
    run_started: datetime,
    stage_results: list[StageResult],
    validation_results: list[dict[str, Any]],
    json_valid: bool,
) -> dict[str, Any]:
    run_completed = utc_now()

    pending_retries = 0
    permanent_failures = 0
    successful_transcripts = 0

    retry_data = load_json(ROOT / "transcript-retries.json", {})

    if isinstance(retry_data, dict):
        for record in retry_data.values():
            if not isinstance(record, dict):
                continue

            status = record.get("status")

            if status == "pending":
                pending_retries += 1
            elif status == "permanent_failure":
                permanent_failures += 1
            elif status == "success":
                successful_transcripts += 1

    manifest = load_json(ROOT / "transcript-manifest.json", [])
    transcript_count = len(manifest) if isinstance(manifest, list) else None

    radar = load_json(ROOT / "drama-radar.json", [])
    radar_item_count = len(radar) if isinstance(radar, list) else None

    mention_index = load_json(ROOT / "mention-index.json", {})
    total_mentions = None
    entity_count = None

    if isinstance(mention_index, dict):
        total_mentions = mention_index.get("total_mentions")
        entity_count = mention_index.get("entity_count")

    failed_stages = [
        result.name
        for result in stage_results
        if not result.success
    ]

    overall_success = json_valid and not failed_stages

    return {
        "status": "healthy" if overall_success else "degraded",
        "run_started_at": run_started.isoformat(),
        "run_completed_at": run_completed.isoformat(),
        "duration_seconds": round(
            (run_completed - run_started).total_seconds(),
            2,
        ),
        "computer": socket.gethostname(),
        "process_id": os.getpid(),
        "overall_success": overall_success,
        "json_validation_passed": json_valid,
        "failed_stages": failed_stages,
        "radar_item_count": radar_item_count,
        "transcript_count": transcript_count,
        "entity_count": entity_count,
        "total_mentions": total_mentions,
        "transcript_retries": {
            "pending": pending_retries,
            "permanent_failures": permanent_failures,
            "success_records": successful_transcripts,
        },
        "stages": [
            asdict(result)
            for result in stage_results
        ],
        "json_files": validation_results,
    }


# ============================================================
# MAIN PIPELINE
# ============================================================

def main() -> int:
    os.chdir(ROOT)
    prepare_logs()

    run_started = utc_now()
    stage_results: list[StageResult] = []
    validation_results: list[dict[str, Any]] = []
    json_valid = False

    write_log("=" * 65)
    write_log("DRAMA RADAR AUTOMATED RUN")
    write_log(f"Project folder: {ROOT}")
    write_log(f"Python: {PYTHON_EXECUTABLE}")
    write_log("=" * 65)

    if not acquire_lock():
        return 2

    try:
        # ----------------------------------------------------
        # STAGE 1: COLLECT SOURCES
        # ----------------------------------------------------

        collector = find_collector_script()

        if collector is None:
            stage_results.append(
                run_command(
                    name="Source collection",
                    command=[PYTHON_EXECUTABLE],
                    skip_reason=(
                        "No collector script was found. Add its filename "
                        "to COLLECTOR_CANDIDATES in run_drama_radar.py."
                    ),
                )
            )
        else:
            stage_results.append(
                run_command(
                    name="Source collection",
                    command=[
                        PYTHON_EXECUTABLE,
                        str(collector),
                    ],
                )
            )

        # ----------------------------------------------------
        # STAGE 2: TRANSCRIPTS AND MENTION COUNTS
        # ----------------------------------------------------

        transcript_path = ROOT / TRANSCRIPT_SCRIPT

        if transcript_path.exists():
            stage_results.append(
                run_command(
                    name="Transcript enrichment",
                    command=[
                        PYTHON_EXECUTABLE,
                        str(transcript_path),
                    ],
                )
            )
        else:
            stage_results.append(
                run_command(
                    name="Transcript enrichment",
                    command=[PYTHON_EXECUTABLE],
                    skip_reason=(
                        f"{TRANSCRIPT_SCRIPT} was not found."
                    ),
                )
            )

        # ----------------------------------------------------
        # STAGE 3: VALIDATION
        # ----------------------------------------------------

        json_valid, validation_results = validate_all_json()

        # Write health before Git so it can be included in the commit.
        preliminary_health = build_health_report(
            run_started=run_started,
            stage_results=stage_results,
            validation_results=validation_results,
            json_valid=json_valid,
        )
        save_json(HEALTH_FILE, preliminary_health)

        # ----------------------------------------------------
        # STAGE 4: GIT
        # ----------------------------------------------------

        if json_valid:
            stage_results.extend(perform_git_update())
        else:
            stage_results.append(
                run_command(
                    name="Git update",
                    command=["git"],
                    skip_reason=(
                        "Git commit blocked because required JSON "
                        "validation failed."
                    ),
                )
            )

        final_health = build_health_report(
            run_started=run_started,
            stage_results=stage_results,
            validation_results=validation_results,
            json_valid=json_valid,
        )
        save_json(HEALTH_FILE, final_health)

        write_log("")
        write_log("=" * 65)
        write_log(
            "FINAL STATUS: "
            + final_health["status"].upper()
        )
        write_log(
            f"Radar entries: {final_health['radar_item_count']}"
        )
        write_log(
            f"Transcripts: {final_health['transcript_count']}"
        )
        write_log(
            f"Entities: {final_health['entity_count']}"
        )
        write_log(
            f"Mentions: {final_health['total_mentions']}"
        )
        write_log(
            "Pending transcript retries: "
            f"{final_health['transcript_retries']['pending']}"
        )

        if final_health["failed_stages"]:
            write_log(
                "Failed stages: "
                + ", ".join(final_health["failed_stages"])
            )

        write_log("=" * 65)

        return 0 if final_health["overall_success"] else 1

    except KeyboardInterrupt:
        write_log("Run interrupted by user.")
        return 130

    except Exception as error:
        write_log(f"UNHANDLED ERROR: {type(error).__name__}: {error}")
        write_log(traceback.format_exc())

        emergency_health = {
            "status": "failed",
            "run_started_at": run_started.isoformat(),
            "run_completed_at": iso_now(),
            "overall_success": False,
            "error": f"{type(error).__name__}: {error}",
            "traceback": traceback.format_exc(),
            "stages": [
                asdict(result)
                for result in stage_results
            ],
        }

        save_json(HEALTH_FILE, emergency_health)
        return 1

    finally:
        release_lock()
        archive_current_log()


if __name__ == "__main__":
    raise SystemExit(main())
